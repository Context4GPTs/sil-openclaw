{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sil.com/shopping-content-response.schema.json",
  "title": "sil shopping_content — response",
  "type": "object",
  "required": [
    "status",
    "passages"
  ],
  "properties": {
    "status": {
      "type": "string",
      "const": "ok",
      "description": "Reads the answer. Every other status arrives as an error body carrying recovery."
    },
    "passages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "title",
          "text"
        ],
        "properties": {
          "kind": {
            "anyOf": [
              {
                "type": "string",
                "const": "guide"
              },
              {
                "type": "string",
                "const": "tutorial"
              },
              {
                "type": "string",
                "const": "faq"
              },
              {
                "type": "string",
                "const": "glossary"
              },
              {
                "type": "string",
                "const": "review"
              },
              {
                "type": "string",
                "const": "comparison"
              },
              {
                "type": "string",
                "const": "news"
              },
              {
                "type": "string",
                "const": "discussion"
              }
            ],
            "description": "Reads what the document is."
          },
          "title": {
            "type": "string",
            "description": "Cites the document by it."
          },
          "author": {
            "type": "string",
            "description": "Cites who wrote it; absent, sil did."
          },
          "text": {
            "type": "string",
            "description": "Reads the passage."
          },
          "url": {
            "type": "string",
            "description": "Hands the buyer the source."
          },
          "publish_date": {
            "type": "string",
            "format": "date",
            "description": "Says when it was published, every time it is cited."
          }
        },
        "additionalProperties": false
      },
      "description": "Reads sil’s passages, best first. Empty: say so, never the open web."
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sil.com/shopping-search-response.schema.json",
  "title": "sil shopping_search — response",
  "type": "object",
  "required": [
    "status",
    "products",
    "receipt"
  ],
  "properties": {
    "status": {
      "type": "string",
      "const": "ok",
      "description": "Reads the answer. Every other status arrives as an error body carrying recovery."
    },
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "fit",
          "price",
          "variants"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "description": "Names the product."
          },
          "title": {
            "type": "string",
            "description": "Draws the card with it."
          },
          "brand": {
            "type": "string",
            "description": "Names the maker."
          },
          "image": {
            "type": "string",
            "description": "Shows it."
          },
          "leaf": {
            "type": "string",
            "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)*$",
            "maxLength": 255,
            "description": "On a search over a kind: which leaf it is."
          },
          "fit": {
            "type": "object",
            "patternProperties": {
              "^.*$": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "string"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                ]
              }
            },
            "description": "Answers each asked key with the value sil holds, or `\"unknown\"`: what to say as unverified."
          },
          "price": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "from",
                "to",
                "currency"
              ],
              "properties": {
                "from": {
                  "type": "string",
                  "pattern": "^[0-9]+(\\.[0-9]+)?$",
                  "description": "Quotes the low end of what the product costs in this currency."
                },
                "to": {
                  "type": "string",
                  "pattern": "^[0-9]+(\\.[0-9]+)?$",
                  "description": "Quotes the high end."
                },
                "currency": {
                  "type": "string",
                  "pattern": "^[A-Z]{3}$",
                  "minLength": 3,
                  "maxLength": 3,
                  "description": "Reads which currency the range is in; sil converts nothing."
                }
              },
              "additionalProperties": false
            },
            "description": "Quotes the range over the variants returned."
          },
          "variants": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "price"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "description": "Passes it to `shopping_product_get` and `shopping_offers`."
                },
                "price": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "from",
                      "to",
                      "currency"
                    ],
                    "properties": {
                      "from": {
                        "type": "string",
                        "pattern": "^[0-9]+(\\.[0-9]+)?$",
                        "description": "Quotes the low end of what the product costs in this currency."
                      },
                      "to": {
                        "type": "string",
                        "pattern": "^[0-9]+(\\.[0-9]+)?$",
                        "description": "Quotes the high end."
                      },
                      "currency": {
                        "type": "string",
                        "pattern": "^[A-Z]{3}$",
                        "minLength": 3,
                        "maxLength": 3,
                        "description": "Reads which currency the range is in; sil converts nothing."
                      }
                    },
                    "additionalProperties": false
                  },
                  "description": "Quotes what THIS option costs, over its own offers; a currency other than the ask's is a bound sil could not test."
                }
              },
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "string"
                  },
                  {
                    "type": "boolean"
                  }
                ]
              },
              "description": "A variant that answers the ask, and every option value that identifies it. One carrying none is a listing sil has not read sizes from."
            },
            "description": "Passes an `id` to the dossier and offers."
          },
          "host": {
            "type": "string",
            "description": "Names the shop whose page was read in this call."
          },
          "printed": {
            "type": "object",
            "patternProperties": {
              "^.*$": {
                "type": "string"
              }
            },
            "description": "Reads labelled pairs no key catches."
          }
        },
        "additionalProperties": false
      },
      "description": "Shows the shortlist in this order."
    },
    "receipt": {
      "type": "object",
      "required": [
        "shops",
        "products",
        "fit",
        "could_not_tell",
        "set_aside"
      ],
      "properties": {
        "shops": {
          "type": "integer",
          "minimum": 0,
          "description": "Says how many shops sil looked across."
        },
        "products": {
          "type": "integer",
          "minimum": 0,
          "description": "Says how many products sil weighed; every line below adds up to it."
        },
        "fit": {
          "type": "integer",
          "minimum": 0,
          "description": "Says how many meet every asked spec on values sil read."
        },
        "could_not_tell": {
          "type": "integer",
          "minimum": 0,
          "description": "Says how many sil could not tell: nothing failed, a value was unread. Never a failure."
        },
        "set_aside": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "count",
              "key"
            ],
            "properties": {
              "count": {
                "type": "integer",
                "minimum": 0,
                "description": "Says how many were set aside on this key, each product once, on its first failing spec."
              },
              "key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "description": "Names the asked spec they failed."
              },
              "values": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "maxItems": 3,
                "description": "On a choice: the values they held, most common first."
              }
            },
            "additionalProperties": false
          },
          "maxItems": 8,
          "description": "Says why the rest were set aside, in the buyer’s words."
        }
      },
      "additionalProperties": false,
      "description": "Shows the buyer what sil checked, in a shop assistant’s words; relayed, never recounted."
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sil.com/shopping-seller-get-request.schema.json",
  "title": "sil shopping_seller_get — request",
  "type": "object",
  "required": [
    "ids"
  ],
  "properties": {
    "ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "description": "An id sil minted, passed back verbatim."
      },
      "minItems": 1,
      "maxItems": 10,
      "description": "Sends the seller ids the offers named."
    },
    "ship_to": {
      "type": "string",
      "pattern": "^[A-Za-z]{2}$",
      "description": "Names the destination; absent, sil fills it from the buyer's registered address."
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sil.com/shopping-user-remember-response.schema.json",
  "title": "sil shopping_user_remember — response",
  "type": "object",
  "required": [
    "status",
    "kept"
  ],
  "properties": {
    "status": {
      "type": "string",
      "const": "ok",
      "description": "Reads the answer. Every other status arrives as an error body carrying recovery."
    },
    "kept": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "gives_back"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "description": "Names the row to replace it, and to forget it."
          },
          "kind": {
            "anyOf": [
              {
                "type": "string",
                "const": "memory"
              },
              {
                "type": "string",
                "const": "measurement"
              },
              {
                "type": "string",
                "const": "preference"
              },
              {
                "type": "string",
                "const": "owned"
              }
            ],
            "description": "Reads which kind was kept."
          },
          "gives_back": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "Says what the row gives the buyer back next time; said when it is kept."
          }
        },
        "additionalProperties": false
      },
      "description": "Tells the buyer each keep, what it gives back, and that \"forget that\" undoes it."
    },
    "tips": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "tip"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "description": "Names the kept row the tip is about."
          },
          "tip": {
            "type": "string",
            "minLength": 1,
            "description": "Teaches the fix: does it this turn."
          }
        },
        "additionalProperties": false
      },
      "minItems": 1,
      "description": "A new owned row kept as sent, without sil’s product id: finds it and resends the row once. Absent: nothing to fix."
    },
    "shared": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "spec",
          "value"
        ],
        "properties": {
          "spec": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "Names the spec, as the domain read lists it."
          },
          "value": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "boolean"
                    }
                  ]
                },
                "minItems": 1
              }
            ],
            "description": "The value every one holds; a list, the values common to all."
          }
        },
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 20,
      "description": "Reads what the products this keep links all hold, by spec: keeps one as a liking only when the buyer said they like it. Absent: fewer than two products, or nothing shared."
    }
  },
  "additionalProperties": false
}

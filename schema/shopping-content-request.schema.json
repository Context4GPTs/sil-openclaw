{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sil.com/shopping-content-request.schema.json",
  "title": "sil shopping_content — request",
  "type": "object",
  "required": [
    "path",
    "about"
  ],
  "properties": {
    "path": {
      "type": "string",
      "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)*$",
      "maxLength": 255,
      "description": "Sends the place whose line is read: the place itself, every kind it is, what sits beneath it and every place above it."
    },
    "about": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Sends the words to find, as the buyer or a shop says them; a \"quoted phrase\" is one term. Passages holding every word come first."
    },
    "kinds": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string",
            "const": "guide"
          },
          {
            "type": "string",
            "const": "tutorial"
          },
          {
            "type": "string",
            "const": "faq"
          },
          {
            "type": "string",
            "const": "glossary"
          },
          {
            "type": "string",
            "const": "review"
          },
          {
            "type": "string",
            "const": "comparison"
          },
          {
            "type": "string",
            "const": "news"
          },
          {
            "type": "string",
            "const": "discussion"
          }
        ],
        "description": "A kind of document."
      },
      "minItems": 1,
      "uniqueItems": true,
      "description": "Reads only these kinds; absent, every kind."
    },
    "max_tokens": {
      "type": "integer",
      "minimum": 200,
      "description": "Caps what the passages cost, a token being four characters; the last is cut at a word and marked `truncated`. At most 2300, a larger ask served at that. Default 2000."
    }
  },
  "additionalProperties": false
}

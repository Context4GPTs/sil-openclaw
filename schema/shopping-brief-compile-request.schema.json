{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sil.com/shopping-brief-compile-request.schema.json",
  "title": "sil shopping_brief_compile — request",
  "type": "object",
  "required": [
    "ref",
    "item"
  ],
  "properties": {
    "ref": {
      "type": "string",
      "pattern": "^brief:[a-z0-9][a-z0-9-]*$",
      "maxLength": 255,
      "description": "Names the Brief, `brief:<slug>`."
    },
    "item": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Names one `## Items` row by its item label, the buyer's word for the thing."
    }
  },
  "additionalProperties": false
}

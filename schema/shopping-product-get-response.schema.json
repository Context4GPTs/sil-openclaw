{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sil.com/shopping-product-get-response.schema.json",
  "title": "sil shopping_product_get — response",
  "type": "object",
  "required": [
    "status",
    "products"
  ],
  "properties": {
    "status": {
      "type": "string",
      "const": "ok",
      "description": "Reads the answer. Every other status arrives as an error body carrying recovery."
    },
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "leaf",
          "images",
          "values",
          "reviews",
          "variants"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "description": "Names the product."
          },
          "title": {
            "type": "string",
            "description": "Names the product."
          },
          "brand": {
            "type": "string",
            "description": "Names the brand it is sold under."
          },
          "maker": {
            "type": "string",
            "description": "Names who makes it; `OEM` where the page names no one."
          },
          "leaf": {
            "type": "string",
            "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)*$",
            "maxLength": 255,
            "description": "Reads what kind of thing it is."
          },
          "images": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Shows it: every picture sil holds, each variant’s own by position."
          },
          "values": {
            "type": "object",
            "patternProperties": {
              "^.*$": {
                "anyOf": [
                  {
                    "anyOf": [
                      {
                        "anyOf": [
                          {
                            "type": "number"
                          },
                          {
                            "type": "boolean"
                          },
                          {
                            "type": "string"
                          }
                        ]
                      },
                      {
                        "type": "object",
                        "required": [
                          "min",
                          "max"
                        ],
                        "properties": {
                          "min": {
                            "type": "number",
                            "description": "Reads the low end."
                          },
                          "max": {
                            "type": "number",
                            "description": "Reads the high end."
                          }
                        },
                        "additionalProperties": false,
                        "description": "A range, in the key’s unit."
                      },
                      {
                        "type": "object",
                        "patternProperties": {
                          "^.*$": {
                            "anyOf": [
                              {
                                "type": "number"
                              },
                              {
                                "type": "boolean"
                              },
                              {
                                "type": "string"
                              }
                            ]
                          }
                        },
                        "description": "One entry of a `records` key."
                      }
                    ]
                  },
                  {
                    "type": "array",
                    "items": {
                      "anyOf": [
                        {
                          "anyOf": [
                            {
                              "type": "number"
                            },
                            {
                              "type": "boolean"
                            },
                            {
                              "type": "string"
                            }
                          ]
                        },
                        {
                          "type": "object",
                          "required": [
                            "min",
                            "max"
                          ],
                          "properties": {
                            "min": {
                              "type": "number",
                              "description": "Reads the low end."
                            },
                            "max": {
                              "type": "number",
                              "description": "Reads the high end."
                            }
                          },
                          "additionalProperties": false,
                          "description": "A range, in the key’s unit."
                        },
                        {
                          "type": "object",
                          "patternProperties": {
                            "^.*$": {
                              "anyOf": [
                                {
                                  "type": "number"
                                },
                                {
                                  "type": "boolean"
                                },
                                {
                                  "type": "string"
                                }
                              ]
                            }
                          },
                          "description": "One entry of a `records` key."
                        }
                      ]
                    }
                  }
                ]
              }
            },
            "description": "Reads every value its variants share, once, keyed as the search takes them."
          },
          "description": {
            "type": "string",
            "description": "Reads the page’s own words about it."
          },
          "pros": {
            "type": "string",
            "description": "Reads what the page praises."
          },
          "cons": {
            "type": "string",
            "description": "Reads what the page warns of."
          },
          "persona": {
            "type": "string",
            "description": "Reads who the page says it is for."
          },
          "reviews": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "source",
                "url",
                "score",
                "of",
                "count"
              ],
              "properties": {
                "source": {
                  "type": "string",
                  "description": "Names the site that gathered the reviews."
                },
                "url": {
                  "type": "string",
                  "description": "Hands the buyer the reviews."
                },
                "score": {
                  "type": "number",
                  "minimum": 0,
                  "description": "Quotes the score as that site gives it."
                },
                "of": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "description": "Reads the scale’s top: 5, 10, 100."
                },
                "count": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Says how many reviews the score rests on."
                }
              },
              "additionalProperties": false
            },
            "description": "Gives scores from sources the shops do not control; empty until sil reads one."
          },
          "variants": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "values",
                "images"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "description": "Passes it to `shopping_offers`."
                },
                "values": {
                  "type": "object",
                  "patternProperties": {
                    "^.*$": {
                      "anyOf": [
                        {
                          "anyOf": [
                            {
                              "anyOf": [
                                {
                                  "type": "number"
                                },
                                {
                                  "type": "boolean"
                                },
                                {
                                  "type": "string"
                                }
                              ]
                            },
                            {
                              "type": "object",
                              "required": [
                                "min",
                                "max"
                              ],
                              "properties": {
                                "min": {
                                  "type": "number",
                                  "description": "Reads the low end."
                                },
                                "max": {
                                  "type": "number",
                                  "description": "Reads the high end."
                                }
                              },
                              "additionalProperties": false,
                              "description": "A range, in the key’s unit."
                            },
                            {
                              "type": "object",
                              "patternProperties": {
                                "^.*$": {
                                  "anyOf": [
                                    {
                                      "type": "number"
                                    },
                                    {
                                      "type": "boolean"
                                    },
                                    {
                                      "type": "string"
                                    }
                                  ]
                                }
                              },
                              "description": "One entry of a `records` key."
                            }
                          ]
                        },
                        {
                          "type": "array",
                          "items": {
                            "anyOf": [
                              {
                                "anyOf": [
                                  {
                                    "type": "number"
                                  },
                                  {
                                    "type": "boolean"
                                  },
                                  {
                                    "type": "string"
                                  }
                                ]
                              },
                              {
                                "type": "object",
                                "required": [
                                  "min",
                                  "max"
                                ],
                                "properties": {
                                  "min": {
                                    "type": "number",
                                    "description": "Reads the low end."
                                  },
                                  "max": {
                                    "type": "number",
                                    "description": "Reads the high end."
                                  }
                                },
                                "additionalProperties": false,
                                "description": "A range, in the key’s unit."
                              },
                              {
                                "type": "object",
                                "patternProperties": {
                                  "^.*$": {
                                    "anyOf": [
                                      {
                                        "type": "number"
                                      },
                                      {
                                        "type": "boolean"
                                      },
                                      {
                                        "type": "string"
                                      }
                                    ]
                                  }
                                },
                                "description": "One entry of a `records` key."
                              }
                            ]
                          }
                        }
                      ]
                    }
                  },
                  "description": "Reads what sets this variant apart from the product’s others; empty where it is the only one."
                },
                "starting_from": {
                  "type": "object",
                  "required": [
                    "amount",
                    "currency"
                  ],
                  "properties": {
                    "amount": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991,
                      "description": "The amount in the currency’s minor unit (cents): €130 is 13000."
                    },
                    "currency": {
                      "type": "string",
                      "pattern": "^[A-Z]{3}$",
                      "minLength": 3,
                      "maxLength": 3,
                      "description": "In this currency."
                    }
                  },
                  "additionalProperties": false,
                  "description": "Quotes the lowest one-off price it is sold at; `shopping_offers` lists every offer."
                },
                "images": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "description": "Shows its own pictures: positions in the product’s `images`, first its best."
                }
              },
              "additionalProperties": false
            },
            "description": "Lists every variant: pick the ones to buy, then read their offers."
          }
        },
        "additionalProperties": false
      },
      "description": "Reads the whole before recommending."
    }
  },
  "additionalProperties": false
}

                            "description": "Says which site the value or sentence rests on."
                          },
                          "url": {
                            "type": "string",
                            "description": "Hands the buyer the page."
                          },
                          "read_at": {
                            "type": "string",
                            "format": "date-time",
                            "description": "Says when sil read it."
                          }
                        },
                        "additionalProperties": false
                      },
                      "maxItems": 3,
                      "description": "The pages behind the sentence; empty where it rests on sil’s specs alone."

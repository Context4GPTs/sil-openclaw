{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sil.com/shopping-product-get-response.schema.json",
  "title": "sil shopping_product_get — response",
  "type": "object",
  "required": [
    "status",
    "products"
  ],
  "properties": {
    "status": {
      "type": "string",
      "const": "ok",
      "description": "Reads the answer. Every other status arrives as an error body carrying recovery."
    },
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "product_id",
          "title",
          "images",
          "product",
          "sources",
          "pages",
          "variants"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "description": "Matches the entry to the id asked for."
          },
          "product_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "description": "Names the product."
          },
          "variant_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "description": "Names the variant asked for, where a variant id was sent."
          },
          "title": {
            "type": "string",
            "description": "Tells the buyer what it is."
          },
          "brand": {
            "type": "string",
            "description": "Names the brand it is sold under."
          },
          "maker": {
            "type": "string",
            "description": "Names who makes it, `\"OEM\"` for a maker sil cannot name; absent when unknown."
          },
          "leaf": {
            "type": "string",
            "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)*$",
            "maxLength": 255,
            "description": "Names the leaf whose sheet `product` fills."
          },
          "images": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 5,
            "description": "Shows it."
          },
          "product": {
            "type": "object",
            "patternProperties": {
              "^.*$": {}
            },
            "description": "Reads it as its leaf’s sheet filled: each spec under its field; `made_of` with each part’s `number` and `type` (its entries, as the pages stated them); `options` with each axis’s `type` (the values sold). A range is `[min, max]`, money `{ amount, currency }`."
          },
          "sources": {
            "type": "object",
            "patternProperties": {
              "^.*$": {
                "type": "integer",
                "minimum": 0
              }
            },
            "description": "Names the page each value rests on: its path, then its index in `pages`."
          },
          "pages": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "host",
                "url",
                "read_at",
                "by"
              ],
              "properties": {
                "host": {
                  "type": "string",
                  "description": "Says which site the value rests on."
                },
                "url": {
                  "type": "string",
                  "description": "Hands the buyer the page."
                },
                "read_at": {
                  "type": "string",
                  "format": "date-time",
                  "description": "Says when sil read it."
                },
                "by": {
                  "anyOf": [
                    {
                      "type": "string",
                      "const": "maker"
                    },
                    {
                      "type": "string",
                      "const": "shop"
                    },
                    {
                      "type": "string",
                      "const": "content"
                    }
                  ],
                  "description": "Says whose page it is: the maker’s own, a shop’s, or a content site’s."
                }
              },
              "additionalProperties": false
            },
            "description": "Says where and when sil read them."
          },
          "variants": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "name",
                "selection"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "description": "Passes it to `shopping_offers`."
                },
                "name": {
                  "type": "string",
                  "description": "Names the option as the shop prints it."
                },
                "selection": {
                  "type": "object",
                  "patternProperties": {
                    "^.*$": {}
                  },
                  "description": "Reads the value it takes on each option axis of `product.options`."
                },
                "gtin": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Its barcodes."
                }
              },
              "additionalProperties": false
            },
            "description": "Lists every option sold, with what it chooses."
          }
        },
        "additionalProperties": false
      },
      "description": "Reads the whole before recommending."
    },
    "not_held": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Echoes the id asked for."
          },
          "reason": {
            "type": "string",
            "description": "Says why sil has no dossier, and what to do instead."
          }
        },
        "additionalProperties": false
      },
      "minItems": 1,
      "description": "Names each id sil holds no product for; the agent says so and searches."
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sil.com/shopping-product-get-response.schema.json",
  "title": "sil shopping_product_get — response",
  "type": "object",
  "required": [
    "status",
    "variants"
  ],
  "properties": {
    "status": {
      "type": "string",
      "const": "ok",
      "description": "Reads the answer. Every other status arrives as an error body carrying recovery."
    },
    "variants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "images",
          "specs",
          "sources"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "description": "Matches the entry to the id asked for."
          },
          "title": {
            "type": "string",
            "description": "Tells the buyer what it is."
          },
          "brand": {
            "type": "string",
            "description": "Names the maker."
          },
          "description": {
            "type": "string",
            "description": "Quotes the page's own description."
          },
          "images": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Shows it."
          },
          "specs": {
            "type": "object",
            "patternProperties": {
              "^.*$": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "string"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                ]
              }
            },
            "description": "Compares on every key sil holds."
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "host",
                "read_at"
              ],
              "properties": {
                "host": {
                  "type": "string",
                  "description": "Says which site sil read."
                },
                "read_at": {
                  "type": "string",
                  "format": "date-time",
                  "description": "Says when sil read it."
                }
              },
              "additionalProperties": false
            },
            "description": "Says where and when sil read them."
          },
          "reviews": {
            "type": "object",
            "required": [
              "count",
              "praised",
              "complained",
              "sources"
            ],
            "properties": {
              "count": {
                "type": "integer",
                "minimum": 1,
                "description": "Says how many reviews sil read."
              },
              "score": {
                "type": "object",
                "required": [
                  "value",
                  "of"
                ],
                "properties": {
                  "value": {
                    "type": "number",
                    "minimum": 0,
                    "description": "The average score."
                  },
                  "of": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "description": "The scale’s top: 5, 10, 100."
                  }
                },
                "additionalProperties": false,
                "description": "Says the average score on its own scale, where the reviews give one."
              },
              "praised": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "description": "One thing reviewers praise."
                },
                "maxItems": 5,
                "description": "Says what reviewers praise, most often first."
              },
              "complained": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "description": "One thing reviewers complain of."
                },
                "maxItems": 5,
                "description": "Says what reviewers complain of, most often first."
              },
              "sources": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "name",
                    "url",
                    "date"
                  ],
                  "properties": {
                    "name": {
                      "type": "string",
                      "description": "Names the site or reviewer."
                    },
                    "url": {
                      "type": "string",
                      "description": "Hands the buyer the reviews."
                    },
                    "date": {
                      "type": "string",
                      "format": "date",
                      "description": "Dates the latest review read there."
                    }
                  },
                  "additionalProperties": false
                },
                "minItems": 1,
                "maxItems": 5,
                "description": "Cites where, and how recent."
              }
            },
            "additionalProperties": false,
            "description": "Tells the buyer what other buyers said, from the reviews sil holds; absent until it holds any."
          },
          "webpage_info": {
            "type": "object",
            "required": [
              "url",
              "text"
            ],
            "properties": {
              "url": {
                "type": "string",
                "description": "Links the page it read the words off."
              },
              "text": {
                "type": "string",
                "description": "Reads the whole page in the shop's own words for what sil has not keyed yet — a provisional read, never a verified one."
              }
            },
            "additionalProperties": false,
            "description": "Reads a page sil has not read yet, in the page's own words."
          }
        },
        "additionalProperties": false
      },
      "description": "Reads the whole before recommending."
    }
  },
  "additionalProperties": false
}

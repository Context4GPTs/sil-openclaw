{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sil.com/shopping-brief-write-request.schema.json",
  "title": "sil shopping_brief_write — request",
  "anyOf": [
    {
      "type": "object",
      "required": [
        "title",
        "narrative"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Opens a brief: names the buy so the buyer picks it out later."
        },
        "narrative": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "description": "Writes what a good buy is for this buyer, in their terms, and what would make it a bad one."
        },
        "domain": {
          "type": "string",
          "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)*$",
          "maxLength": 255,
          "description": "Names where `specs` and `remove` sit: a place, or `seller` for seller specs."
        },
        "specs": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "object",
                "required": [
                  "spec",
                  "op",
                  "value"
                ],
                "properties": {
                  "spec": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64,
                    "description": "Sends a spec the domain read listed, unchanged: a part’s by its path (`boiler.boilerVolume`)."
                  },
                  "op": {
                    "anyOf": [
                      {
                        "type": "string",
                        "const": "eq"
                      },
                      {
                        "type": "string",
                        "const": "neq"
                      },
                      {
                        "type": "string",
                        "const": "gte"
                      },
                      {
                        "type": "string",
                        "const": "lte"
                      },
                      {
                        "type": "string",
                        "const": "in"
                      },
                      {
                        "type": "string",
                        "const": "nin"
                      }
                    ],
                    "description": "Sends the operator the domain read listed for this spec."
                  },
                  "value": {
                    "description": "Sends the desired value, typed by the spec's type."
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256,
                    "description": "Quotes the buyer's own words behind the spec, in English — translated, never a paraphrase, never a sentence they did not say; a spec derived from a measurement quotes the measurement. Reads them back before proposing to relax it."
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": [
                  "spec",
                  "range"
                ],
                "properties": {
                  "spec": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64,
                    "description": "Names a money spec: `price`, or a seller’s money spec."
                  },
                  "range": {
                    "type": "object",
                    "required": [
                      "currency"
                    ],
                    "properties": {
                      "min": {
                        "type": "integer",
                        "minimum": 0,
                        "description": "The low end, in the minor unit."
                      },
                      "max": {
                        "type": "integer",
                        "minimum": 0,
                        "description": "The high end, in the minor unit."
                      },
                      "currency": {
                        "type": "string",
                        "pattern": "^[A-Z]{3}$",
                        "minLength": 3,
                        "maxLength": 3,
                        "description": "Both ends in this currency; sil converts nothing."
                      }
                    },
                    "additionalProperties": false,
                    "description": "Holds the money spec’s range, one or both ends."
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256,
                    "description": "Quotes the buyer's own words behind the spec, in English — translated, never a paraphrase, never a sentence they did not say; a spec derived from a measurement quotes the measurement. Reads them back before proposing to relax it."
                  }
                },
                "additionalProperties": false
              }
            ]
          },
          "maxItems": 32,
          "description": "Replaces every spec on the specs they name under that domain; a money spec is its range."
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "Edits this brief; one that is not the buyer’s answers `not_found`."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Renames it."
        },
        "narrative": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "description": "Replaces the whole narrative."
        },
        "domain": {
          "type": "string",
          "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)*$",
          "maxLength": 255,
          "description": "Names where `specs` and `remove` sit: a place, or `seller` for seller specs."
        },
        "specs": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "object",
                "required": [
                  "spec",
                  "op",
                  "value"
                ],
                "properties": {
                  "spec": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64,
                    "description": "Sends a spec the domain read listed, unchanged: a part’s by its path (`boiler.boilerVolume`)."
                  },
                  "op": {
                    "anyOf": [
                      {
                        "type": "string",
                        "const": "eq"
                      },
                      {
                        "type": "string",
                        "const": "neq"
                      },
                      {
                        "type": "string",
                        "const": "gte"
                      },
                      {
                        "type": "string",
                        "const": "lte"
                      },
                      {
                        "type": "string",
                        "const": "in"
                      },
                      {
                        "type": "string",
                        "const": "nin"
                      }
                    ],
                    "description": "Sends the operator the domain read listed for this spec."
                  },
                  "value": {
                    "description": "Sends the desired value, typed by the spec's type."
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256,
                    "description": "Quotes the buyer's own words behind the spec, in English — translated, never a paraphrase, never a sentence they did not say; a spec derived from a measurement quotes the measurement. Reads them back before proposing to relax it."
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": [
                  "spec",
                  "range"
                ],
                "properties": {
                  "spec": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64,
                    "description": "Names a money spec: `price`, or a seller’s money spec."
                  },
                  "range": {
                    "type": "object",
                    "required": [
                      "currency"
                    ],
                    "properties": {
                      "min": {
                        "type": "integer",
                        "minimum": 0,
                        "description": "The low end, in the minor unit."
                      },
                      "max": {
                        "type": "integer",
                        "minimum": 0,
                        "description": "The high end, in the minor unit."
                      },
                      "currency": {
                        "type": "string",
                        "pattern": "^[A-Z]{3}$",
                        "minLength": 3,
                        "maxLength": 3,
                        "description": "Both ends in this currency; sil converts nothing."
                      }
                    },
                    "additionalProperties": false,
                    "description": "Holds the money spec’s range, one or both ends."
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256,
                    "description": "Quotes the buyer's own words behind the spec, in English — translated, never a paraphrase, never a sentence they did not say; a spec derived from a measurement quotes the measurement. Reads them back before proposing to relax it."
                  }
                },
                "additionalProperties": false
              }
            ]
          },
          "maxItems": 32,
          "description": "Replaces every spec on the specs they name under that domain; a money spec is its range."
        },
        "remove": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "A spec whose rows go."
          },
          "maxItems": 32,
          "description": "Drops the rows on these specs."
        },
        "decision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "description": "Logs in one sentence what the buyer changed and why."
        },
        "status": {
          "type": "string",
          "const": "closed",
          "description": "Closes it: the buy is over."
        }
      },
      "additionalProperties": false
    }
  ],
  "type": "object",
  "description": "Money is in the minor unit: €130 is 13000."
}

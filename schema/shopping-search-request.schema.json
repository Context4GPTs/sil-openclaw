{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sil.com/shopping-search-request.schema.json",
  "title": "sil shopping_search — request",
  "type": "object",
  "required": [
    "domain"
  ],
  "properties": {
    "domain": {
      "type": "string",
      "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)*$",
      "maxLength": 255,
      "description": "Sends the leaf, or the kind above its leaves when the question is which kind; a shelf, domain or top answers `not_a_leaf`."
    },
    "specs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "op",
          "value"
        ],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "Sends a key the domain read listed, unchanged: a part’s by its path (`boiler.boilerVolume`)."
          },
          "op": {
            "anyOf": [
              {
                "type": "string",
                "const": "eq"
              },
              {
                "type": "string",
                "const": "neq"
              },
              {
                "type": "string",
                "const": "gte"
              },
              {
                "type": "string",
                "const": "lte"
              },
              {
                "type": "string",
                "const": "in"
              },
              {
                "type": "string",
                "const": "nin"
              }
            ],
            "description": "Sends the operator the domain read listed for this key."
          },
          "value": {
            "description": "Sends the desired value, typed by the key's type."
          }
        },
        "additionalProperties": false
      },
      "maxItems": 32,
      "description": "Sends every settled want: a key from the domain read, one of its operators, a value in its unit or its set; on a kind, `leaf` in or nin its leaves."
    },
    "price": {
      "type": "object",
      "properties": {
        "min": {
          "type": "object",
          "required": [
            "value",
            "currency"
          ],
          "properties": {
            "value": {
              "type": "number",
              "minimum": 0,
              "description": "Quotes the amount."
            },
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$",
              "minLength": 3,
              "maxLength": 3,
              "description": "Quotes it in this currency."
            }
          },
          "additionalProperties": false,
          "description": "Keeps variants with an offer at or above it."
        },
        "max": {
          "type": "object",
          "required": [
            "value",
            "currency"
          ],
          "properties": {
            "value": {
              "type": "number",
              "minimum": 0,
              "description": "Quotes the amount."
            },
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$",
              "minLength": 3,
              "maxLength": 3,
              "description": "Quotes it in this currency."
            }
          },
          "additionalProperties": false,
          "description": "Keeps variants with an offer at or under it."
        }
      },
      "additionalProperties": false,
      "description": "Tests each variant’s own offers in the money’s currency; sil converts nothing."
    },
    "query": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "description": "Sends the words the buyer used for what no spec holds — a name, a model, \"travel\" — matched against the products’ titles and words."
    },
    "n": {
      "type": "integer",
      "minimum": 1,
      "description": "Asks for this many products, at most 10; default 5."
    },
    "brief": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "Ties the call to a brief in sil’s record; never required."
    }
  },
  "additionalProperties": false
}

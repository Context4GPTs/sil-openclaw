{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sil.com/shopping-offers-response.schema.json",
  "title": "sil shopping_offers — response",
  "type": "object",
  "required": [
    "status",
    "offers"
  ],
  "properties": {
    "status": {
      "type": "string",
      "const": "ok",
      "description": "Reads the answer. Every other status arrives as an error body carrying recovery."
    },
    "offers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "variant_id",
          "title",
          "seller_id",
          "seller_name",
          "price",
          "currency",
          "availability",
          "observed_at",
          "url",
          "seller_fit"
        ],
        "properties": {
          "variant_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "description": "Matches the offer to the pick; passes it to the dossier."
          },
          "title": {
            "type": "string",
            "description": "Names what the listing sells."
          },
          "seller_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "description": "Passes it to `shopping_seller_get`."
          },
          "seller_name": {
            "type": "string",
            "description": "Names the shop."
          },
          "price": {
            "type": "string",
            "pattern": "^[0-9]+(\\.[0-9]+)?$",
            "description": "Quotes the price as read, never converted."
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$",
            "minLength": 3,
            "maxLength": 3,
            "description": "Quotes the price in this currency."
          },
          "availability": {
            "anyOf": [
              {
                "type": "string",
                "const": "in_stock"
              },
              {
                "type": "string",
                "const": "backorder"
              },
              {
                "type": "string",
                "const": "preorder"
              },
              {
                "type": "string",
                "const": "out_of_stock"
              },
              {
                "type": "string",
                "const": "discontinued"
              },
              {
                "type": "string",
                "const": "unknown"
              }
            ],
            "description": "Tells the buyer whether it can be bought now."
          },
          "observed_at": {
            "type": "string",
            "format": "date-time",
            "description": "Dates the price: when sil last read it."
          },
          "url": {
            "type": "string",
            "description": "Hands the buyer the listing."
          },
          "seller_fit": {
            "type": "object",
            "required": [
              "ships"
            ],
            "properties": {
              "ships": {
                "anyOf": [
                  {
                    "type": "string",
                    "const": "serviceable"
                  },
                  {
                    "type": "string",
                    "const": "not_serviceable"
                  },
                  {
                    "type": "string",
                    "const": "unknown"
                  }
                ],
                "description": "Says whether it ships there; `unknown` keeps the seller and says sil has not read its policy."
              }
            },
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "string"
                },
                {
                  "type": "object",
                  "required": [
                    "amount",
                    "currency"
                  ],
                  "properties": {
                    "amount": {
                      "type": "string",
                      "pattern": "^[0-9]+(\\.[0-9]+)?$",
                      "description": "Quotes the amount as the page states it."
                    },
                    "currency": {
                      "type": "string",
                      "pattern": "^[A-Z]{3}$",
                      "minLength": 3,
                      "maxLength": 3,
                      "description": "Quotes the amount in this currency."
                    }
                  },
                  "additionalProperties": false
                }
              ]
            },
            "description": "Compares each requested seller key with what it asked, on this seller's value; `ships` says whether it reaches the address."
          }
        },
        "additionalProperties": false
      },
      "description": "Lists where it can be bought, best for the buyer first."
    }
  },
  "additionalProperties": false
}

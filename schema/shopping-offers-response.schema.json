{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sil.com/shopping-offers-response.schema.json",
  "title": "sil shopping_offers — response",
  "type": "object",
  "required": [
    "status",
    "ship_to",
    "offers"
  ],
  "properties": {
    "status": {
      "type": "string",
      "const": "ok",
      "description": "Reads the answer. Every other status arrives as an error body carrying recovery."
    },
    "ship_to": {
      "type": "object",
      "required": [
        "country"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "Names the address."
        },
        "locality": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Says the town."
        },
        "country": {
          "type": "string",
          "pattern": "^[A-Z]{2}$",
          "minLength": 2,
          "maxLength": 2,
          "description": "Says the country every `ships` is relative to."
        }
      },
      "additionalProperties": false,
      "description": "Says where delivery was priced to: every `ships` is relative to it."
    },
    "offers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "variant_id",
          "seller",
          "price",
          "url",
          "read_on"
        ],
        "properties": {
          "variant_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "description": "Matches the offer to the variant asked for."
          },
          "seller": {
            "type": "object",
            "required": [
              "id",
              "host",
              "country",
              "ships"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "description": "Passes it to `shopping_seller_get` for its delivery, returns and terms."
              },
              "host": {
                "type": "string",
                "description": "Names the shop by its site."
              },
              "country": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[A-Z]{2}$",
                    "minLength": 2,
                    "maxLength": 2,
                    "description": "Where the shop is."
                  },
                  {
                    "type": "string",
                    "const": "unknown"
                  }
                ],
                "description": "Says where the shop is."
              },
              "ships": {
                "anyOf": [
                  {
                    "type": "string",
                    "const": "serviceable"
                  },
                  {
                    "type": "string",
                    "const": "not_serviceable"
                  },
                  {
                    "type": "string",
                    "const": "unknown"
                  }
                ],
                "description": "Says whether it ships there; `unknown` keeps the seller and says sil has not read its policy."
              }
            },
            "additionalProperties": false,
            "description": "The shop selling it."
          },
          "price": {
            "type": "object",
            "required": [
              "value",
              "currency"
            ],
            "properties": {
              "value": {
                "type": "number",
                "minimum": 0,
                "description": "Quotes the amount."
              },
              "currency": {
                "type": "string",
                "pattern": "^[A-Z]{3}$",
                "minLength": 3,
                "maxLength": 3,
                "description": "Quotes it in this currency."
              }
            },
            "additionalProperties": false,
            "description": "Quotes what it costs, as the shop printed it."
          },
          "was": {
            "type": "object",
            "required": [
              "value",
              "currency"
            ],
            "properties": {
              "value": {
                "type": "number",
                "minimum": 0,
                "description": "Quotes the amount."
              },
              "currency": {
                "type": "string",
                "pattern": "^[A-Z]{3}$",
                "minLength": 3,
                "maxLength": 3,
                "description": "Quotes it in this currency."
              }
            },
            "additionalProperties": false,
            "description": "Quotes the price it was, struck through."
          },
          "availability": {
            "anyOf": [
              {
                "type": "string",
                "const": "in_stock"
              },
              {
                "type": "string",
                "const": "backorder"
              },
              {
                "type": "string",
                "const": "preorder"
              },
              {
                "type": "string",
                "const": "by_enquiry"
              },
              {
                "type": "string",
                "const": "out_of_stock"
              },
              {
                "type": "string",
                "const": "discontinued"
              },
              {
                "type": "string",
                "const": "unknown"
              }
            ],
            "description": "Tells the buyer whether it can be bought now."
          },
          "condition": {
            "anyOf": [
              {
                "type": "string",
                "const": "new"
              },
              {
                "type": "string",
                "const": "used"
              },
              {
                "type": "string",
                "const": "refurbished"
              },
              {
                "type": "string",
                "const": "damaged"
              }
            ],
            "description": "Says it is not sold new where the shop says so; absent, new or unstated."
          },
          "plan": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "description": "Says the price is a subscription’s, and each cadence the shop offers."
          },
          "pack": {
            "type": "object",
            "required": [
              "count",
              "with"
            ],
            "properties": {
              "count": {
                "type": "integer",
                "minimum": 1,
                "description": "Says how many of the variant it holds."
              },
              "with": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Names what else comes in it."
              }
            },
            "additionalProperties": false,
            "description": "Says the price buys a pack or a bundle, not one of the variant."
          },
          "url": {
            "type": "string",
            "description": "Hands the buyer the listing."
          },
          "read_on": {
            "type": "string",
            "format": "date",
            "description": "Dates the price: the day sil read it."
          }
        },
        "additionalProperties": false,
        "description": "One shop’s offer of a variant."
      },
      "description": "Lists where each variant can be bought: shops shipping to `ship_to` first, cheapest first."
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sil.com/shopping-domain-get-response.schema.json",
  "title": "sil shopping_domain_get — response",
  "type": "object",
  "required": [
    "status",
    "path",
    "name",
    "reached",
    "specs"
  ],
  "properties": {
    "status": {
      "type": "string",
      "const": "ok",
      "description": "Reads the answer. Every other status arrives as an error body carrying recovery."
    },
    "path": {
      "type": "string",
      "description": "Sends it verbatim as `shopping_search.domain`."
    },
    "name": {
      "type": "string",
      "maxLength": 64,
      "description": "Calls the place this."
    },
    "reached": {
      "type": "integer",
      "minimum": 0,
      "description": "Says how many of the first specs answer the buyer’s words; the rest follow by how many products hold them."
    },
    "specs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "spec",
          "type",
          "operators"
        ],
        "properties": {
          "spec": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "Sends it unchanged as `shopping_search.specs[].spec`: a part’s by its path (`burrSet.burrMaterial`), the box by `with`."
          },
          "type": {
            "anyOf": [
              {
                "type": "string",
                "const": "number"
              },
              {
                "type": "string",
                "const": "boolean"
              },
              {
                "type": "string",
                "const": "enum"
              }
            ],
            "description": "Types the value the agent sends and reads for this key."
          },
          "unit": {
            "type": "string",
            "minLength": 1,
            "description": "Sends the value in this unit."
          },
          "values": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "description": "Maps the buyer's word into this set; where `gte`/`lte` are offered, they run least first."
          },
          "operators": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string",
                  "const": "eq"
                },
                {
                  "type": "string",
                  "const": "neq"
                },
                {
                  "type": "string",
                  "const": "gte"
                },
                {
                  "type": "string",
                  "const": "lte"
                },
                {
                  "type": "string",
                  "const": "in"
                },
                {
                  "type": "string",
                  "const": "nin"
                }
              ]
            },
            "minItems": 1,
            "description": "Sends one of these as the spec’s `op`."
          },
          "decides": {
            "type": "boolean",
            "const": true,
            "description": "Decides this kind of buy: ask the buyer for it where sil holds no answer."
          },
          "why": {
            "type": "string",
            "minLength": 1,
            "description": "Says what a deciding spec decides, in the graph’s words: teach and ask from it."
          }
        },
        "additionalProperties": false
      },
      "description": "Lists the specs a search here takes: those `spec_keywords` and `query` reach first, then those most products hold a value for; a spec of the thing no product holds only where they reach it, a part’s never."
    },
    "next_page": {
      "type": "integer",
      "minimum": 2,
      "description": "Sends it as `page` to read the specs on; absent on the last page."
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sil.com/shopping-domain-get-response.schema.json",
  "title": "sil shopping_domain_get — response",
  "type": "object",
  "required": [
    "status",
    "path",
    "name",
    "labels",
    "specs",
    "seller_specs",
    "reach",
    "kinds",
    "parts",
    "made_for"
  ],
  "properties": {
    "status": {
      "type": "string",
      "const": "ok",
      "description": "Reads the answer. Every other status arrives as an error body carrying recovery."
    },
    "path": {
      "type": "string",
      "description": "Sends it verbatim as `shopping_search.domain`."
    },
    "name": {
      "type": "string",
      "maxLength": 64,
      "description": "Calls the thing this in English."
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 64
      },
      "maxItems": 20,
      "description": "Reads every other word for the thing; never sends them."
    },
    "specs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "display_name",
          "type",
          "operators"
        ],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "Names the key in the Brief and sends it as a `shopping_search` spec key."
          },
          "display_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "Calls the key this when it writes it down or says it out loud."
          },
          "description": {
            "type": "string",
            "maxLength": 1024,
            "description": "Reads how this one key moves the fit — what it decides, what goes wrong at either end of it, and how a buyer's own fact becomes a value for it. Reason from it; ask from it; never recite it back."
          },
          "type": {
            "anyOf": [
              {
                "type": "string",
                "const": "number"
              },
              {
                "type": "string",
                "const": "boolean"
              },
              {
                "type": "string",
                "const": "enum"
              },
              {
                "type": "string",
                "const": "money"
              }
            ],
            "description": "Types the value the agent sends and reads for this key."
          },
          "unit": {
            "type": "string",
            "minLength": 1,
            "description": "States the value in this unit, the one sil holds it in."
          },
          "allowed_values": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "description": "Maps the buyer's word into the closed set; an enum without one takes any name, a maker's for `brand`."
          },
          "operators": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string",
                  "const": "eq"
                },
                {
                  "type": "string",
                  "const": "neq"
                },
                {
                  "type": "string",
                  "const": "gte"
                },
                {
                  "type": "string",
                  "const": "lte"
                },
                {
                  "type": "string",
                  "const": "in"
                },
                {
                  "type": "string",
                  "const": "nin"
                }
              ]
            },
            "minItems": 1,
            "description": "Picks the comparison that fits: `eq`/`in` on a variant spec and on enums, `gte`/`lte` on numbers and money."
          },
          "step": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "Asks on the grid the maker prints the axis in — 0.5 for a Mondopoint size. A figure off the grid is something sil has not read as a value."
          },
          "forms": {
            "type": "object",
            "patternProperties": {
              "^.*$": {
                "type": "string"
              }
            },
            "description": "Reads what pages print for a value, mapped to the value — `{\"27/27.5\": \"27.5\"}`. Never sent: the request takes the value, and this is how sil recognises it in the wild."
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            },
            "minItems": 1,
            "maxItems": 20,
            "description": "Sends any of these as the key and reaches this one: the names sil maps here — the headings pages print it under and the keys other agents send for it, one mapping with no origin between them. Folded to the form the mapping stores, best-attested first, at most 20."
          },
          "variant_spec": {
            "type": "boolean",
            "const": true,
            "description": "Expects its values under `variants[]`."
          },
          "product_spec": {
            "type": "boolean",
            "const": true,
            "description": "Never treats two products that differ on it as one."
          },
          "several": {
            "type": "boolean",
            "const": true,
            "description": "Reads a list for it: a product holds several at once."
          },
          "ordered": {
            "type": "boolean",
            "const": true,
            "description": "`allowed_values` run in order, least first: `gte`/`lte` take one and reach every one past it — \"filter or coarser\" is `gte filter`, never `eq filter`."
          }
        },
        "additionalProperties": false
      },
      "description": "Builds spec rows with keys sil holds."
    },
    "seller_specs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "display_name",
          "type",
          "operators"
        ],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "Names the key in the Brief and sends it as a `shopping_search` spec key."
          },
          "display_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "Calls the key this when it writes it down or says it out loud."
          },
          "description": {
            "type": "string",
            "maxLength": 1024,
            "description": "Reads how this one key moves the fit — what it decides, what goes wrong at either end of it, and how a buyer's own fact becomes a value for it. Reason from it; ask from it; never recite it back."
          },
          "type": {
            "anyOf": [
              {
                "type": "string",
                "const": "number"
              },
              {
                "type": "string",
                "const": "boolean"
              },
              {
                "type": "string",
                "const": "enum"
              },
              {
                "type": "string",
                "const": "money"
              }
            ],
            "description": "Types the value the agent sends and reads for this key."
          },
          "unit": {
            "type": "string",
            "minLength": 1,
            "description": "States the value in this unit, the one sil holds it in."
          },
          "allowed_values": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "description": "Maps the buyer's word into the closed set; an enum without one takes any name, a maker's for `brand`."
          },
          "operators": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string",
                  "const": "eq"
                },
                {
                  "type": "string",
                  "const": "neq"
                },
                {
                  "type": "string",
                  "const": "gte"
                },
                {
                  "type": "string",
                  "const": "lte"
                },
                {
                  "type": "string",
                  "const": "in"
                },
                {
                  "type": "string",
                  "const": "nin"
                }
              ]
            },
            "minItems": 1,
            "description": "Picks the comparison that fits: `eq`/`in` on a variant spec and on enums, `gte`/`lte` on numbers and money."
          },
          "step": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "Asks on the grid the maker prints the axis in — 0.5 for a Mondopoint size. A figure off the grid is something sil has not read as a value."
          },
          "forms": {
            "type": "object",
            "patternProperties": {
              "^.*$": {
                "type": "string"
              }
            },
            "description": "Reads what pages print for a value, mapped to the value — `{\"27/27.5\": \"27.5\"}`. Never sent: the request takes the value, and this is how sil recognises it in the wild."
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            },
            "minItems": 1,
            "maxItems": 20,
            "description": "Sends any of these as the key and reaches this one: the names sil maps here — the headings pages print it under and the keys other agents send for it, one mapping with no origin between them. Folded to the form the mapping stores, best-attested first, at most 20."
          }
        },
        "additionalProperties": false
      },
      "description": "Builds seller rows for `shopping_offers`."
    },
    "reach": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "via",
          "keys"
        ],
        "properties": {
          "from": {
            "type": "string",
            "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)*$",
            "maxLength": 255,
            "description": "Reads the node that declares these keys."
          },
          "via": {
            "anyOf": [
              {
                "type": "string",
                "const": "own"
              },
              {
                "type": "string",
                "const": "kind"
              },
              {
                "type": "string",
                "const": "part"
              },
              {
                "type": "string",
                "const": "leaf"
              }
            ],
            "description": "Reads how: its own, a kind it is, a part’s link, or a leaf under a kind."
          },
          "part": {
            "type": "string",
            "description": "Names the part, where `via` is one."
          },
          "keys": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "description": "A key."
            },
            "description": "Reads the keys, in the node’s order."
          }
        },
        "additionalProperties": false
      },
      "description": "Reads where each key comes from."
    },
    "kinds": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "name"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)*$",
            "maxLength": 255,
            "description": "Reads the kind on its own node."
          },
          "name": {
            "type": "string",
            "maxLength": 64,
            "description": "Calls the kind this."
          }
        },
        "additionalProperties": false
      },
      "description": "Reads every kind this thing is, nearest first."
    },
    "parts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "how",
          "optional",
          "many",
          "keys"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Calls the part this."
          },
          "role": {
            "type": "string",
            "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)*$",
            "maxLength": 255,
            "description": "Reads the node any thing that fills this part is."
          },
          "elsewhere": {
            "type": "string",
            "description": "Reads the part in plain words, where no node draws it yet."
          },
          "how": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string",
                  "const": "built in"
                },
                {
                  "type": "string",
                  "const": "in the box"
                },
                {
                  "type": "string",
                  "const": "sold separately"
                },
                {
                  "type": "string",
                  "const": "used with"
                }
              ]
            },
            "description": "Knows whether the part is built in, in the box, bought apart or used with it."
          },
          "optional": {
            "type": "boolean",
            "description": "Knows whether some of these things come without it."
          },
          "many": {
            "type": "boolean",
            "description": "Knows whether the thing has several of the part."
          },
          "keys": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "description": "Reads the keys the link says about the part, here."
          }
        },
        "additionalProperties": false
      },
      "description": "Reads what the thing has."
    },
    "made_for": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)*$",
                "maxLength": 255,
                "description": "Reads the node this part or consumable is made for."
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "elsewhere"
            ],
            "properties": {
              "elsewhere": {
                "type": "string",
                "description": "Reads what it is made for in plain words, where no node draws it yet."
              }
            },
            "additionalProperties": false
          }
        ]
      },
      "description": "Reads what a part is made for."
    },
    "leaves": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "name"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)*$",
            "maxLength": 255,
            "description": "Sends the leaf to `shopping_domain_get` or `shopping_search`."
          },
          "name": {
            "type": "string",
            "maxLength": 64,
            "description": "Calls the leaf this."
          }
        },
        "additionalProperties": false
      },
      "description": "On a kind: every leaf under it. A search on the kind answers across them, `leaf` a key it takes."
    },
    "record": {
      "anyOf": [
        {
          "type": "string",
          "const": "full"
        },
        {
          "type": "string",
          "const": "specs"
        }
      ],
      "description": "On a leaf: bought on its measures alone, or on its measures and its record."
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sil.com/shopping-seller-get-response.schema.json",
  "title": "sil shopping_seller_get — response",
  "type": "object",
  "required": [
    "status",
    "sellers"
  ],
  "properties": {
    "status": {
      "type": "string",
      "const": "ok",
      "description": "Reads the answer. Every other status arrives as an error body carrying recovery."
    },
    "sellers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "host",
          "country",
          "ships",
          "policy_urls",
          "specs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "description": "Matches the seller to its offers."
          },
          "name": {
            "type": "string",
            "description": "Names the shop."
          },
          "host": {
            "type": "string",
            "description": "Names the site the buyer would buy from."
          },
          "country": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Z]{2}$",
                "minLength": 2,
                "maxLength": 2,
                "description": "Where the shop is."
              },
              {
                "type": "string",
                "const": "unknown"
              }
            ],
            "description": "Says where the shop is; `unknown`, sil has not read it."
          },
          "ships": {
            "anyOf": [
              {
                "type": "string",
                "const": "serviceable"
              },
              {
                "type": "string",
                "const": "not_serviceable"
              },
              {
                "type": "string",
                "const": "unknown"
              }
            ],
            "description": "Says whether it ships there; `unknown` keeps the seller and says sil has not read its policy."
          },
          "delivery": {
            "type": "object",
            "properties": {
              "cost": {
                "anyOf": [
                  {
                    "type": "object",
                    "required": [
                      "amount",
                      "currency"
                    ],
                    "properties": {
                      "amount": {
                        "type": "string",
                        "pattern": "^[0-9]+(\\.[0-9]+)?$",
                        "description": "Quotes the amount as the page states it."
                      },
                      "currency": {
                        "type": "string",
                        "pattern": "^[A-Z]{3}$",
                        "minLength": 3,
                        "maxLength": 3,
                        "description": "Quotes the amount in this currency."
                      }
                    },
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "required": [
                      "min",
                      "max",
                      "currency"
                    ],
                    "properties": {
                      "min": {
                        "type": "string",
                        "pattern": "^[0-9]+(\\.[0-9]+)?$",
                        "description": "Quotes the low end."
                      },
                      "max": {
                        "type": "string",
                        "pattern": "^[0-9]+(\\.[0-9]+)?$",
                        "description": "Quotes the high end."
                      },
                      "currency": {
                        "type": "string",
                        "pattern": "^[A-Z]{3}$",
                        "minLength": 3,
                        "maxLength": 3,
                        "description": "Quotes the range in this currency."
                      }
                    },
                    "additionalProperties": false
                  }
                ],
                "description": "Quotes what delivery there costs."
              },
              "free_over": {
                "type": "object",
                "required": [
                  "amount",
                  "currency"
                ],
                "properties": {
                  "amount": {
                    "type": "string",
                    "pattern": "^[0-9]+(\\.[0-9]+)?$",
                    "description": "Quotes the amount as the page states it."
                  },
                  "currency": {
                    "type": "string",
                    "pattern": "^[A-Z]{3}$",
                    "minLength": 3,
                    "maxLength": 3,
                    "description": "Quotes the amount in this currency."
                  }
                },
                "additionalProperties": false,
                "description": "Quotes the basket that clears the charge."
              },
              "days": {
                "type": "object",
                "required": [
                  "min",
                  "max"
                ],
                "properties": {
                  "min": {
                    "type": "integer",
                    "description": "Tells the buyer the soonest it arrives."
                  },
                  "max": {
                    "type": "integer",
                    "description": "Tells the buyer the latest."
                  }
                },
                "additionalProperties": false,
                "description": "Tells the buyer how long the route takes."
              }
            },
            "additionalProperties": false,
            "description": "Tells the buyer what delivery to their address costs and how long it takes."
          },
          "returns": {
            "type": "object",
            "properties": {
              "window_days": {
                "type": "integer",
                "minimum": 0,
                "description": "Days to send it back."
              },
              "restocking_fee": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "The share of the price withheld."
              }
            },
            "additionalProperties": false,
            "description": "Tells the buyer the return terms."
          },
          "warranty": {
            "type": "object",
            "required": [
              "months"
            ],
            "properties": {
              "months": {
                "type": "integer",
                "minimum": 0,
                "description": "How long the shop’s warranty runs."
              }
            },
            "additionalProperties": false,
            "description": "Tells the buyer the shop’s warranty."
          },
          "policy_urls": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "kind",
                "url"
              ],
              "properties": {
                "kind": {
                  "anyOf": [
                    {
                      "type": "string",
                      "const": "shipping"
                    },
                    {
                      "type": "string",
                      "const": "returns"
                    },
                    {
                      "type": "string",
                      "const": "warranty"
                    },
                    {
                      "type": "string",
                      "const": "terms"
                    }
                  ],
                  "description": "Reads which policy the page holds."
                },
                "url": {
                  "type": "string",
                  "description": "Opens the shop’s own page."
                }
              },
              "additionalProperties": false
            },
            "description": "Hands the buyer the shop’s own policy pages; a link is not a claim."
          },
          "specs": {
            "type": "object",
            "patternProperties": {
              "^.*$": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "string"
                  }
                ]
              }
            },
            "description": "Reads every seller key sil holds a value for."
          },
          "reviews": {
            "type": "object",
            "required": [
              "count",
              "praised",
              "complained",
              "sources"
            ],
            "properties": {
              "count": {
                "type": "integer",
                "minimum": 1,
                "description": "Says how many reviews sil read."
              },
              "score": {
                "type": "object",
                "required": [
                  "value",
                  "of"
                ],
                "properties": {
                  "value": {
                    "type": "number",
                    "minimum": 0,
                    "description": "The average score."
                  },
                  "of": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "description": "The scale’s top: 5, 10, 100."
                  }
                },
                "additionalProperties": false,
                "description": "Says the average score on its own scale, where the reviews give one."
              },
              "praised": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "description": "One thing reviewers praise."
                },
                "maxItems": 5,
                "description": "Says what reviewers praise, most often first."
              },
              "complained": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "description": "One thing reviewers complain of."
                },
                "maxItems": 5,
                "description": "Says what reviewers complain of, most often first."
              },
              "sources": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "name",
                    "url",
                    "date"
                  ],
                  "properties": {
                    "name": {
                      "type": "string",
                      "description": "Names the site or reviewer."
                    },
                    "url": {
                      "type": "string",
                      "description": "Hands the buyer the reviews."
                    },
                    "date": {
                      "type": "string",
                      "format": "date",
                      "description": "Dates the latest review read there."
                    }
                  },
                  "additionalProperties": false
                },
                "minItems": 1,
                "maxItems": 5,
                "description": "Cites where, and how recent."
              }
            },
            "additionalProperties": false,
            "description": "Tells the buyer what other buyers said, from the reviews sil holds; absent until it holds any."
          }
        },
        "additionalProperties": false
      },
      "description": "Reads the terms before recommending a seller."
    }
  },
  "additionalProperties": false
}

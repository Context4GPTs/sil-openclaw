{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sil.com/shopping-seller-get-response.schema.json",
  "title": "sil shopping_seller_get — response",
  "type": "object",
  "required": [
    "status",
    "sellers"
  ],
  "properties": {
    "status": {
      "type": "string",
      "const": "ok",
      "description": "Reads the answer. Every other status arrives as an error body carrying recovery."
    },
    "sellers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "host",
          "country",
          "ships",
          "policy_urls",
          "specs",
          "reviews",
          "sources"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "description": "Matches the seller to its offers."
          },
          "name": {
            "type": "string",
            "description": "Names the shop."
          },
          "host": {
            "type": "string",
            "description": "Names the site the buyer would buy from."
          },
          "country": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Z]{2}$",
                "minLength": 2,
                "maxLength": 2,
                "description": "Where the shop is."
              },
              {
                "type": "string",
                "const": "unknown"
              }
            ],
            "description": "Says where the shop is; `unknown`, sil has not read it."
          },
          "ships": {
            "anyOf": [
              {
                "type": "string",
                "const": "serviceable"
              },
              {
                "type": "string",
                "const": "not_serviceable"
              },
              {
                "type": "string",
                "const": "unknown"
              }
            ],
            "description": "Says whether it ships there; `unknown` keeps the seller and says sil has not read its policy."
          },
          "delivery": {
            "type": "object",
            "properties": {
              "cost": {
                "anyOf": [
                  {
                    "type": "object",
                    "required": [
                      "amount",
                      "currency"
                    ],
                    "properties": {
                      "amount": {
                        "type": "string",
                        "pattern": "^[0-9]+(\\.[0-9]+)?$",
                        "description": "Quotes the amount as the page states it."
                      },
                      "currency": {
                        "type": "string",
                        "pattern": "^[A-Z]{3}$",
                        "minLength": 3,
                        "maxLength": 3,
                        "description": "Quotes the amount in this currency."
                      }
                    },
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "required": [
                      "min",
                      "max",
                      "currency"
                    ],
                    "properties": {
                      "min": {
                        "type": "string",
                        "pattern": "^[0-9]+(\\.[0-9]+)?$",
                        "description": "Quotes the low end."
                      },
                      "max": {
                        "type": "string",
                        "pattern": "^[0-9]+(\\.[0-9]+)?$",
                        "description": "Quotes the high end."
                      },
                      "currency": {
                        "type": "string",
                        "pattern": "^[A-Z]{3}$",
                        "minLength": 3,
                        "maxLength": 3,
                        "description": "Quotes the range in this currency."
                      }
                    },
                    "additionalProperties": false
                  }
                ],
                "description": "Quotes what delivery there costs."
              },
              "free_over": {
                "type": "object",
                "required": [
                  "amount",
                  "currency"
                ],
                "properties": {
                  "amount": {
                    "type": "string",
                    "pattern": "^[0-9]+(\\.[0-9]+)?$",
                    "description": "Quotes the amount as the page states it."
                  },
                  "currency": {
                    "type": "string",
                    "pattern": "^[A-Z]{3}$",
                    "minLength": 3,
                    "maxLength": 3,
                    "description": "Quotes the amount in this currency."
                  }
                },
                "additionalProperties": false,
                "description": "Quotes the basket that clears the charge."
              },
              "days": {
                "type": "object",
                "required": [
                  "min",
                  "max"
                ],
                "properties": {
                  "min": {
                    "type": "integer",
                    "description": "Tells the buyer the soonest it arrives."
                  },
                  "max": {
                    "type": "integer",
                    "description": "Tells the buyer the latest."
                  }
                },
                "additionalProperties": false,
                "description": "Tells the buyer how long the route takes."
              }
            },
            "additionalProperties": false,
            "description": "Tells the buyer what delivery to their address costs and how long it takes."
          },
          "policy_urls": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "kind",
                "url"
              ],
              "properties": {
                "kind": {
                  "anyOf": [
                    {
                      "type": "string",
                      "const": "shipping"
                    },
                    {
                      "type": "string",
                      "const": "returns"
                    },
                    {
                      "type": "string",
                      "const": "warranty"
                    },
                    {
                      "type": "string",
                      "const": "terms"
                    }
                  ],
                  "description": "Reads which policy the page holds."
                },
                "url": {
                  "type": "string",
                  "description": "Opens the shop’s own page."
                }
              },
              "additionalProperties": false
            },
            "description": "Hands the buyer the shop’s own policy pages, those it prints first; a link is not a claim."
          },
          "contact": {
            "type": "object",
            "properties": {
              "email": {
                "type": "string",
                "description": "Writes to the shop."
              },
              "phone": {
                "type": "string",
                "description": "Calls the shop."
              }
            },
            "additionalProperties": false,
            "description": "Reaches the shop, as it prints them."
          },
          "specs": {
            "type": "object",
            "properties": {
              "who": {
                "type": "object",
                "patternProperties": {
                  "^.*$": {
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "string"
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      {
                        "type": "object",
                        "required": [
                          "amount",
                          "currency"
                        ],
                        "properties": {
                          "amount": {
                            "type": "string",
                            "pattern": "^[0-9]+(\\.[0-9]+)?$",
                            "description": "Quotes the amount as the page states it."
                          },
                          "currency": {
                            "type": "string",
                            "pattern": "^[A-Z]{3}$",
                            "minLength": 3,
                            "maxLength": 3,
                            "description": "Quotes the amount in this currency."
                          }
                        },
                        "additionalProperties": false
                      }
                    ]
                  }
                },
                "description": "Says who the shop is."
              },
              "delivery": {
                "type": "object",
                "patternProperties": {
                  "^.*$": {
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "string"
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      {
                        "type": "object",
                        "required": [
                          "amount",
                          "currency"
                        ],
                        "properties": {
                          "amount": {
                            "type": "string",
                            "pattern": "^[0-9]+(\\.[0-9]+)?$",
                            "description": "Quotes the amount as the page states it."
                          },
                          "currency": {
                            "type": "string",
                            "pattern": "^[A-Z]{3}$",
                            "minLength": 3,
                            "maxLength": 3,
                            "description": "Quotes the amount in this currency."
                          }
                        },
                        "additionalProperties": false
                      }
                    ]
                  }
                },
                "description": "Says how the shop delivers, beyond the buyer’s own address."
              },
              "payment": {
                "type": "object",
                "patternProperties": {
                  "^.*$": {
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "string"
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      {
                        "type": "object",
                        "required": [
                          "amount",
                          "currency"
                        ],
                        "properties": {
                          "amount": {
                            "type": "string",
                            "pattern": "^[0-9]+(\\.[0-9]+)?$",
                            "description": "Quotes the amount as the page states it."
                          },
                          "currency": {
                            "type": "string",
                            "pattern": "^[A-Z]{3}$",
                            "minLength": 3,
                            "maxLength": 3,
                            "description": "Quotes the amount in this currency."
                          }
                        },
                        "additionalProperties": false
                      }
                    ]
                  }
                },
                "description": "Says how the buyer pays."
              },
              "support": {
                "type": "object",
                "patternProperties": {
                  "^.*$": {
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "string"
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      {
                        "type": "object",
                        "required": [
                          "amount",
                          "currency"
                        ],
                        "properties": {
                          "amount": {
                            "type": "string",
                            "pattern": "^[0-9]+(\\.[0-9]+)?$",
                            "description": "Quotes the amount as the page states it."
                          },
                          "currency": {
                            "type": "string",
                            "pattern": "^[A-Z]{3}$",
                            "minLength": 3,
                            "maxLength": 3,
                            "description": "Quotes the amount in this currency."
                          }
                        },
                        "additionalProperties": false
                      }
                    ]
                  }
                },
                "description": "Says how the buyer reaches help."
              },
              "returns": {
                "type": "object",
                "patternProperties": {
                  "^.*$": {
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "string"
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      {
                        "type": "object",
                        "required": [
                          "amount",
                          "currency"
                        ],
                        "properties": {
                          "amount": {
                            "type": "string",
                            "pattern": "^[0-9]+(\\.[0-9]+)?$",
                            "description": "Quotes the amount as the page states it."
                          },
                          "currency": {
                            "type": "string",
                            "pattern": "^[A-Z]{3}$",
                            "minLength": 3,
                            "maxLength": 3,
                            "description": "Quotes the amount in this currency."
                          }
                        },
                        "additionalProperties": false
                      }
                    ]
                  }
                },
                "description": "Says how a return works."
              },
              "warranty": {
                "type": "object",
                "patternProperties": {
                  "^.*$": {
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "string"
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      {
                        "type": "object",
                        "required": [
                          "amount",
                          "currency"
                        ],
                        "properties": {
                          "amount": {
                            "type": "string",
                            "pattern": "^[0-9]+(\\.[0-9]+)?$",
                            "description": "Quotes the amount as the page states it."
                          },
                          "currency": {
                            "type": "string",
                            "pattern": "^[A-Z]{3}$",
                            "minLength": 3,
                            "maxLength": 3,
                            "description": "Quotes the amount in this currency."
                          }
                        },
                        "additionalProperties": false
                      }
                    ]
                  }
                },
                "description": "Says what the shop stands behind."
              },
              "guarantees": {
                "type": "object",
                "patternProperties": {
                  "^.*$": {
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "string"
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      {
                        "type": "object",
                        "required": [
                          "amount",
                          "currency"
                        ],
                        "properties": {
                          "amount": {
                            "type": "string",
                            "pattern": "^[0-9]+(\\.[0-9]+)?$",
                            "description": "Quotes the amount as the page states it."
                          },
                          "currency": {
                            "type": "string",
                            "pattern": "^[A-Z]{3}$",
                            "minLength": 3,
                            "maxLength": 3,
                            "description": "Quotes the amount in this currency."
                          }
                        },
                        "additionalProperties": false
                      }
                    ]
                  }
                },
                "description": "Says what the shop promises."
              }
            },
            "additionalProperties": false,
            "description": "Reads every seller key sil holds a value for, by the lever it weighs the shop by; a lever with nothing held is absent."
          },
          "reviews": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "source",
                "url",
                "score",
                "of",
                "count",
                "read_at"
              ],
              "properties": {
                "source": {
                  "type": "string",
                  "description": "Names the site that gathered the reviews."
                },
                "url": {
                  "type": "string",
                  "description": "Hands the buyer the reviews."
                },
                "score": {
                  "type": "number",
                  "minimum": 0,
                  "description": "The score as that site gives it."
                },
                "of": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "description": "The scale’s top: 5, 10, 100."
                },
                "count": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "How many reviews the score rests on."
                },
                "read_at": {
                  "type": "string",
                  "format": "date-time",
                  "description": "Says when sil read it."
                }
              },
              "additionalProperties": false
            },
            "description": "Gives scores from a source the shop does not control; empty until sil reads one."
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "host",
                "url",
                "read_at"
              ],
              "properties": {
                "host": {
                  "type": "string",
                  "description": "Says which site the value rests on."
                },
                "url": {
                  "type": "string",
                  "description": "Hands the buyer the page."
                },
                "read_at": {
                  "type": "string",
                  "format": "date-time",
                  "description": "Says when sil read it."
                }
              },
              "additionalProperties": false
            },
            "maxItems": 12,
            "description": "Names the pages behind these values, newest read first."
          }
        },
        "additionalProperties": false
      },
      "description": "Reads the terms before recommending a seller."
    }
  },
  "additionalProperties": false
}

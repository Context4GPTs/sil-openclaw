{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sil.com/shopping-seller-get-response.schema.json",
  "title": "sil shopping_seller_get — response",
  "type": "object",
  "required": [
    "status",
    "ship_to",
    "sellers"
  ],
  "properties": {
    "status": {
      "type": "string",
      "const": "ok",
      "description": "Reads the answer. Every other status arrives as an error body carrying recovery."
    },
    "ship_to": {
      "type": "object",
      "required": [
        "country"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "Names the address."
        },
        "locality": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Says the town."
        },
        "country": {
          "type": "string",
          "pattern": "^[A-Z]{2}$",
          "minLength": 2,
          "maxLength": 2,
          "description": "Says the country every `ships` is relative to."
        }
      },
      "additionalProperties": false,
      "description": "Says where delivery was priced to: every `ships` is relative to it."
    },
    "sellers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "host",
          "country",
          "ships",
          "promotions",
          "terms",
          "policy_urls",
          "reviews"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "description": "Matches the seller to its offers."
          },
          "name": {
            "type": "string",
            "description": "Names the shop."
          },
          "host": {
            "type": "string",
            "description": "Names the site the buyer would buy from."
          },
          "country": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Z]{2}$",
                "minLength": 2,
                "maxLength": 2,
                "description": "Where the shop is."
              },
              {
                "type": "string",
                "const": "unknown"
              }
            ],
            "description": "Says where the shop is; `unknown`, sil has not read it."
          },
          "ships": {
            "anyOf": [
              {
                "type": "string",
                "const": "serviceable"
              },
              {
                "type": "string",
                "const": "not_serviceable"
              },
              {
                "type": "string",
                "const": "unknown"
              }
            ],
            "description": "Says whether it ships there; `unknown` keeps the seller and says sil has not read its policy."
          },
          "delivery": {
            "type": "object",
            "properties": {
              "cost": {
                "anyOf": [
                  {
                    "type": "object",
                    "required": [
                      "amount",
                      "currency"
                    ],
                    "properties": {
                      "amount": {
                        "type": "integer",
                        "minimum": 0,
                        "description": "The amount in the currency’s minor unit (cents): €130 is 13000."
                      },
                      "currency": {
                        "type": "string",
                        "pattern": "^[A-Z]{3}$",
                        "minLength": 3,
                        "maxLength": 3,
                        "description": "In this currency."
                      }
                    },
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "required": [
                      "currency"
                    ],
                    "properties": {
                      "min": {
                        "type": "integer",
                        "minimum": 0,
                        "description": "The low end, in the minor unit."
                      },
                      "max": {
                        "type": "integer",
                        "minimum": 0,
                        "description": "The high end, in the minor unit."
                      },
                      "currency": {
                        "type": "string",
                        "pattern": "^[A-Z]{3}$",
                        "minLength": 3,
                        "maxLength": 3,
                        "description": "Both ends in this currency; sil converts nothing."
                      }
                    },
                    "additionalProperties": false
                  }
                ],
                "description": "Quotes one fee, or the range from the cheapest route’s to the dearest’s."
              },
              "free_over": {
                "type": "object",
                "required": [
                  "amount",
                  "currency"
                ],
                "properties": {
                  "amount": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "The amount in the currency’s minor unit (cents): €130 is 13000."
                  },
                  "currency": {
                    "type": "string",
                    "pattern": "^[A-Z]{3}$",
                    "minLength": 3,
                    "maxLength": 3,
                    "description": "In this currency."
                  }
                },
                "additionalProperties": false,
                "description": "Quotes the basket that clears the charge."
              },
              "days": {
                "type": "object",
                "required": [
                  "min",
                  "max"
                ],
                "properties": {
                  "min": {
                    "type": "integer",
                    "description": "Tells the buyer the soonest it arrives."
                  },
                  "max": {
                    "type": "integer",
                    "description": "Tells the buyer the latest."
                  }
                },
                "additionalProperties": false,
                "description": "Tells the buyer how long the route takes."
              }
            },
            "additionalProperties": false,
            "description": "Tells the buyer what delivery to their country costs and how long it takes."
          },
          "returns_days": {
            "type": "integer",
            "minimum": 0,
            "description": "Says how many days the buyer has to return it."
          },
          "warranty_months": {
            "type": "integer",
            "minimum": 0,
            "description": "Says how many months the shop stands behind it."
          },
          "promotions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "what"
              ],
              "properties": {
                "what": {
                  "type": "string",
                  "description": "Quotes the promotion as the shop prints it."
                },
                "discount": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100,
                  "description": "Quotes its discount, in percent, where the shop states one."
                },
                "minimum_spend": {
                  "type": "object",
                  "required": [
                    "amount",
                    "currency"
                  ],
                  "properties": {
                    "amount": {
                      "type": "integer",
                      "minimum": 0,
                      "description": "The amount in the currency’s minor unit (cents): €130 is 13000."
                    },
                    "currency": {
                      "type": "string",
                      "pattern": "^[A-Z]{3}$",
                      "minLength": 3,
                      "maxLength": 3,
                      "description": "In this currency."
                    }
                  },
                  "additionalProperties": false,
                  "description": "Quotes the spend it needs."
                },
                "until": {
                  "type": "string",
                  "format": "date",
                  "description": "Says when it ends."
                }
              },
              "additionalProperties": false
            },
            "description": "Quotes the shop’s promotions: ask who qualifies; a reduced price only from `discount` and only on the buyer’s yes."
          },
          "terms": {
            "type": "object",
            "properties": {
              "who": {
                "type": "object",
                "patternProperties": {
                  "^.*$": {
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "string"
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      {
                        "type": "object",
                        "required": [
                          "amount",
                          "currency"
                        ],
                        "properties": {
                          "amount": {
                            "type": "integer",
                            "minimum": 0,
                            "description": "The amount in the currency’s minor unit (cents): €130 is 13000."
                          },
                          "currency": {
                            "type": "string",
                            "pattern": "^[A-Z]{3}$",
                            "minLength": 3,
                            "maxLength": 3,
                            "description": "In this currency."
                          }
                        },
                        "additionalProperties": false
                      }
                    ]
                  }
                },
                "description": "Says who the shop is."
              },
              "delivery": {
                "type": "object",
                "patternProperties": {
                  "^.*$": {
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "string"
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      {
                        "type": "object",
                        "required": [
                          "amount",
                          "currency"
                        ],
                        "properties": {
                          "amount": {
                            "type": "integer",
                            "minimum": 0,
                            "description": "The amount in the currency’s minor unit (cents): €130 is 13000."
                          },
                          "currency": {
                            "type": "string",
                            "pattern": "^[A-Z]{3}$",
                            "minLength": 3,
                            "maxLength": 3,
                            "description": "In this currency."
                          }
                        },
                        "additionalProperties": false
                      }
                    ]
                  }
                },
                "description": "Says how the shop delivers, beyond the buyer’s own country."
              },
              "payment": {
                "type": "object",
                "patternProperties": {
                  "^.*$": {
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "string"
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      {
                        "type": "object",
                        "required": [
                          "amount",
                          "currency"
                        ],
                        "properties": {
                          "amount": {
                            "type": "integer",
                            "minimum": 0,
                            "description": "The amount in the currency’s minor unit (cents): €130 is 13000."
                          },
                          "currency": {
                            "type": "string",
                            "pattern": "^[A-Z]{3}$",
                            "minLength": 3,
                            "maxLength": 3,
                            "description": "In this currency."
                          }
                        },
                        "additionalProperties": false
                      }
                    ]
                  }
                },
                "description": "Says how the buyer pays."
              },
              "support": {
                "type": "object",
                "patternProperties": {
                  "^.*$": {
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "string"
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      {
                        "type": "object",
                        "required": [
                          "amount",
                          "currency"
                        ],
                        "properties": {
                          "amount": {
                            "type": "integer",
                            "minimum": 0,
                            "description": "The amount in the currency’s minor unit (cents): €130 is 13000."
                          },
                          "currency": {
                            "type": "string",
                            "pattern": "^[A-Z]{3}$",
                            "minLength": 3,
                            "maxLength": 3,
                            "description": "In this currency."
                          }
                        },
                        "additionalProperties": false
                      }
                    ]
                  }
                },
                "description": "Says how the buyer reaches help."
              },
              "returns": {
                "type": "object",
                "patternProperties": {
                  "^.*$": {
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "string"
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      {
                        "type": "object",
                        "required": [
                          "amount",
                          "currency"
                        ],
                        "properties": {
                          "amount": {
                            "type": "integer",
                            "minimum": 0,
                            "description": "The amount in the currency’s minor unit (cents): €130 is 13000."
                          },
                          "currency": {
                            "type": "string",
                            "pattern": "^[A-Z]{3}$",
                            "minLength": 3,
                            "maxLength": 3,
                            "description": "In this currency."
                          }
                        },
                        "additionalProperties": false
                      }
                    ]
                  }
                },
                "description": "Says how a return works."
              },
              "warranty": {
                "type": "object",
                "patternProperties": {
                  "^.*$": {
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "string"
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      {
                        "type": "object",
                        "required": [
                          "amount",
                          "currency"
                        ],
                        "properties": {
                          "amount": {
                            "type": "integer",
                            "minimum": 0,
                            "description": "The amount in the currency’s minor unit (cents): €130 is 13000."
                          },
                          "currency": {
                            "type": "string",
                            "pattern": "^[A-Z]{3}$",
                            "minLength": 3,
                            "maxLength": 3,
                            "description": "In this currency."
                          }
                        },
                        "additionalProperties": false
                      }
                    ]
                  }
                },
                "description": "Says what the shop stands behind."
              },
              "guarantees": {
                "type": "object",
                "patternProperties": {
                  "^.*$": {
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "string"
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      {
                        "type": "object",
                        "required": [
                          "amount",
                          "currency"
                        ],
                        "properties": {
                          "amount": {
                            "type": "integer",
                            "minimum": 0,
                            "description": "The amount in the currency’s minor unit (cents): €130 is 13000."
                          },
                          "currency": {
                            "type": "string",
                            "pattern": "^[A-Z]{3}$",
                            "minLength": 3,
                            "maxLength": 3,
                            "description": "In this currency."
                          }
                        },
                        "additionalProperties": false
                      }
                    ]
                  }
                },
                "description": "Says what the shop promises."
              }
            },
            "additionalProperties": false,
            "description": "Reads every other term sil holds, by the lever it weighs the shop by; a lever with nothing held is absent."
          },
          "policy_urls": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "kind",
                "url"
              ],
              "properties": {
                "kind": {
                  "anyOf": [
                    {
                      "type": "string",
                      "const": "shipping"
                    },
                    {
                      "type": "string",
                      "const": "returns"
                    },
                    {
                      "type": "string",
                      "const": "warranty"
                    },
                    {
                      "type": "string",
                      "const": "terms"
                    }
                  ],
                  "description": "Reads which policy the page holds."
                },
                "url": {
                  "type": "string",
                  "description": "Opens the shop’s own page."
                }
              },
              "additionalProperties": false
            },
            "description": "Hands the buyer the shop’s own policy pages."
          },
          "reviews": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "source",
                "url",
                "score",
                "of",
                "count"
              ],
              "properties": {
                "source": {
                  "type": "string",
                  "description": "Names the site that gathered the reviews."
                },
                "url": {
                  "type": "string",
                  "description": "Hands the buyer the reviews."
                },
                "score": {
                  "type": "number",
                  "minimum": 0,
                  "description": "Quotes the score as that site gives it."
                },
                "of": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "description": "Reads the scale’s top: 5, 10, 100."
                },
                "count": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Says how many reviews the score rests on."
                }
              },
              "additionalProperties": false
            },
            "description": "Gives scores from a source the shop does not control; empty until sil reads one."
          }
        },
        "additionalProperties": false
      },
      "description": "Reads the terms before recommending a seller."
    },
    "next_page": {
      "type": "integer",
      "minimum": 2,
      "description": "Sends it as `page` to read the sellers on; absent on the last page."
    }
  },
  "additionalProperties": false
}

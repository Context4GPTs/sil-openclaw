{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sil.com/shopping-domain-search-response.schema.json",
  "title": "sil shopping_domain_search — response",
  "type": "object",
  "required": [
    "status",
    "matches",
    "tree"
  ],
  "properties": {
    "status": {
      "type": "string",
      "const": "ok",
      "description": "Reads the answer. Every other status arrives as an error body carrying recovery."
    },
    "matches": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "about"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)*$",
            "maxLength": 255,
            "description": "Passes it to `shopping_domain_get` and `shopping_search` verbatim."
          },
          "about": {
            "type": "string",
            "description": "Judges fit before reading the whole guide: adopts it, or descends under a broader one."
          }
        },
        "additionalProperties": false
      },
      "maxItems": 20,
      "description": "Reads the nodes that stand for this thing, best first."
    },
    "tree": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "family",
          "domains",
          "paths"
        ],
        "properties": {
          "family": {
            "type": "string",
            "description": "Reads the family this thing would be shelved in, as a specialist shop would."
          },
          "domains": {
            "type": "integer",
            "description": "Sees how much of the tree already sits under it."
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "path",
                "name"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)*$",
                  "maxLength": 255,
                  "description": "Reads it with `shopping_domain_get`, or descends from it."
                },
                "name": {
                  "type": "string",
                  "maxLength": 64,
                  "description": "Sees what this node stands for."
                }
              },
              "additionalProperties": false
            },
            "description": "Adopts one of these, or descends from one."
          }
        },
        "additionalProperties": false
      },
      "description": "Sees where a specialist shop would shelve the thing, and that a setup of several things is several nodes: the standing paths below the root, by family."
    }
  },
  "additionalProperties": false
}

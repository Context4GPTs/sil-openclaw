{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sil.com/shopping-domain-search-response.schema.json",
  "title": "sil shopping_domain_search — response",
  "type": "object",
  "required": [
    "status",
    "matches"
  ],
  "properties": {
    "status": {
      "type": "string",
      "const": "ok",
      "description": "Reads the answer. Every other status arrives as an error body carrying recovery."
    },
    "matches": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "name",
          "role",
          "matched",
          "domain",
          "available"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)*$",
            "maxLength": 255,
            "description": "Passes it to `shopping_domain_get` and `shopping_search` verbatim."
          },
          "name": {
            "type": "string",
            "maxLength": 64,
            "description": "Calls the place this."
          },
          "role": {
            "anyOf": [
              {
                "type": "string",
                "const": "leaf"
              },
              {
                "type": "string",
                "const": "kind"
              },
              {
                "type": "string",
                "const": "shelf"
              },
              {
                "type": "string",
                "const": "domain"
              },
              {
                "type": "string",
                "const": "top"
              }
            ],
            "description": "Prefers a leaf: it is the thing itself; a kind, shelf or domain holds several."
          },
          "matched": {
            "type": "string",
            "description": "Reads which of sil's words for it the ask matched."
          },
          "domain": {
            "type": "object",
            "required": [
              "path",
              "name"
            ],
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)*$",
                "maxLength": 255,
                "description": "Reads the shopping area the place sits in."
              },
              "name": {
                "type": "string",
                "maxLength": 64
              }
            },
            "additionalProperties": false
          },
          "available": {
            "type": "boolean",
            "description": "Shops it when true. False: sil does not carry this area yet — tell the buyer so, and never search for it here or elsewhere."
          },
          "note": {
            "type": "string",
            "const": "We understand this is what you are looking for; it is not available at this moment — it is in the pipeline.",
            "description": "Present exactly when `available` is false."
          }
        },
        "additionalProperties": false
      },
      "maxItems": 3,
      "description": "Reads the most relevant places for these words, leaves and kinds first. Empty: no place matched; rephrase with what the thing is called."
    }
  },
  "additionalProperties": false
}

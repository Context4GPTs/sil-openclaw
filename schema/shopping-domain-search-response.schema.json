{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sil.com/shopping-domain-search-response.schema.json",
  "title": "sil shopping_domain_search — response",
  "type": "object",
  "required": [
    "status",
    "matches"
  ],
  "properties": {
    "status": {
      "type": "string",
      "const": "ok",
      "description": "Reads the answer. Every other status arrives as an error body carrying recovery."
    },
    "matches": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "name",
          "matched",
          "under"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)*$",
            "maxLength": 255,
            "description": "Passes the leaf to `shopping_domain_get` and `shopping_search` verbatim."
          },
          "name": {
            "type": "string",
            "maxLength": 64,
            "description": "Calls the leaf this."
          },
          "matched": {
            "type": "string",
            "description": "Reads which of sil's words for it the ask matched."
          },
          "under": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "path",
                "name",
                "role"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)*$",
                  "maxLength": 255,
                  "description": "Names the place the leaf sits under."
                },
                "name": {
                  "type": "string",
                  "maxLength": 64,
                  "description": "Calls the place this."
                },
                "role": {
                  "anyOf": [
                    {
                      "type": "string",
                      "const": "top"
                    },
                    {
                      "type": "string",
                      "const": "domain"
                    },
                    {
                      "type": "string",
                      "const": "shelf"
                    },
                    {
                      "type": "string",
                      "const": "kind"
                    }
                  ],
                  "description": "Reads what the place is: a top, a domain, a shelf or a kind."
                }
              },
              "additionalProperties": false
            },
            "description": "Reads every place above the leaf, outermost first and its parent last, to judge whether this is the thing the buyer means."
          }
        },
        "additionalProperties": false
      },
      "maxItems": 3,
      "description": "Reads the most relevant leaves for these words and judges which, if any, is the buyer’s thing. Empty: sil holds no such leaf; say so, or rephrase with what the thing is called."
    }
  },
  "additionalProperties": false
}

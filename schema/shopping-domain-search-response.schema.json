{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sil.com/shopping-domain-search-response.schema.json",
  "title": "sil shopping_domain_search — response",
  "type": "object",
  "required": [
    "status",
    "matches"
  ],
  "properties": {
    "status": {
      "type": "string",
      "const": "ok",
      "description": "Reads the answer. Every other status arrives as an error body carrying recovery."
    },
    "matches": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "name"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)*$",
            "maxLength": 255,
            "description": "Sends it to `shopping_domain_get` and `shopping_search`; read outermost first, it names every place the leaf sits under."
          },
          "name": {
            "type": "string",
            "maxLength": 64,
            "description": "Calls the leaf this."
          }
        },
        "additionalProperties": false
      },
      "maxItems": 3,
      "description": "Reads the leaves these words reach, best first, and judges which is the buyer’s thing. Empty: sil holds no such leaf; say so."
    }
  },
  "additionalProperties": false
}

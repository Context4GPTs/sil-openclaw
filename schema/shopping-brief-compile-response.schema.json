{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sil.com/shopping-brief-compile-response.schema.json",
  "title": "sil shopping_brief_compile — response",
  "type": "object",
  "required": [
    "status",
    "item",
    "domain",
    "query",
    "specs",
    "seller_specs"
  ],
  "properties": {
    "status": {
      "type": "string",
      "const": "ok",
      "description": "Reads the answer. Every other status arrives as an error body carrying recovery."
    },
    "item": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Confirms which item this is."
    },
    "domain": {
      "type": "string",
      "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)*$",
      "maxLength": 255,
      "description": "Sends it as `shopping_search.domain`."
    },
    "query": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "description": "Sends it as `shopping_search.query` — the item in the buyer's words."
    },
    "specs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "op",
          "value"
        ],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "Names the key from the domain read; `price` is a key every domain has."
          },
          "op": {
            "anyOf": [
              {
                "type": "string",
                "const": "eq"
              },
              {
                "type": "string",
                "const": "neq"
              },
              {
                "type": "string",
                "const": "gte"
              },
              {
                "type": "string",
                "const": "lte"
              },
              {
                "type": "string",
                "const": "in"
              },
              {
                "type": "string",
                "const": "nin"
              }
            ],
            "description": "Sends the operator the domain read listed for this key."
          },
          "value": {
            "description": "Sends the desired value, typed by the key's type."
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$",
            "minLength": 3,
            "maxLength": 3,
            "description": "Required on money: sil holds no exchange rate, so the bound is tested against offers in this currency only, and `eur` matches no offer sil stores."
          }
        },
        "additionalProperties": false
      },
      "maxItems": 32,
      "description": "Sends it as `shopping_search.specs`, verbatim; hard rows first."
    },
    "seller_specs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "op",
          "value"
        ],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "Names the key from the domain read; `price` is a key every domain has."
          },
          "op": {
            "anyOf": [
              {
                "type": "string",
                "const": "eq"
              },
              {
                "type": "string",
                "const": "neq"
              },
              {
                "type": "string",
                "const": "gte"
              },
              {
                "type": "string",
                "const": "lte"
              },
              {
                "type": "string",
                "const": "in"
              },
              {
                "type": "string",
                "const": "nin"
              }
            ],
            "description": "Sends the operator the domain read listed for this key."
          },
          "value": {
            "description": "Sends the desired value, typed by the key's type."
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$",
            "minLength": 3,
            "maxLength": 3,
            "description": "Required on money: sil holds no exchange rate, so the bound is tested against offers in this currency only, and `eur` matches no offer sil stores."
          }
        },
        "additionalProperties": false
      },
      "maxItems": 32,
      "description": "Sends it as `shopping_offers.seller_specs`, verbatim; hard rows first."
    }
  },
  "additionalProperties": false
}
